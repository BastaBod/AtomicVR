  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Log - Jour 37 :\n\LIsolation totale. Les communications avec l'ext\xE9rieur
    ont \xE9t\xE9 coup\xE9es depuis quelques jours. Mes exp\xE9riences progressent
    lentement, mais j\u2019ai de bons espoirs. Je ne vois plus personne, m\xEAme
    mes coll\xE8gues, de toute fa\xE7on, ils ne peuvent pas comprendre. Dans toute
    cette noirceur, j\u2019ai fait la rencontre d\u2019une jeune femme : Rebecca.
    Son sourire a illumin\xE9 mon c\u0153ur \xE0 travers la noirceur des volutes
    atomiques.\n\nJ\u2019ai mis en place mon mot de passe, le premier symbole est
    cach\xE9 dans l\u2019environnement virtuel. Je l\u2019ai tout simplement <color=red>mis
    au plafond</color> sur l\u2019un circuit imprim\xE9. De toute fa\xE7on personne,
    ne regarde jamais en haut."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
